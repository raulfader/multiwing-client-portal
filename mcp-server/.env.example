# Multi-Wing MCP server configuration. Names only: never commit real values.
# Copy to mcp-server/.env (git-ignored, chmod 600). Host-injected env vars take precedence;
# this file only fills in what the MCP host did not pass.

# Portal origin that serves /api/trpc.
MULTIWING_API_URL=https://multiwing.faderlabs.ai
# Origin used in client-facing links (share invites, project URLs). Defaults to MULTIWING_API_URL.
MULTIWING_PUBLIC_URL=

# Auth (recommended): an admin session token = localStorage "portal_session_token" after logging in at /admin.
MULTIWING_SESSION_TOKEN=
# Auth (alternative or fallback): the LIVE portal admin login (server ADMIN_EMAIL / ADMIN_PASSWORD).
MULTIWING_ADMIN_EMAIL=
MULTIWING_ADMIN_PASSWORD=
# Not used: MULTIWING_PORTAL_PASSWORD / PORTAL_PASSWORD is the client password and cannot run admin tools.

# Local file access (default: MULTIWING_DOWNLOAD_DIR only; "*" = unrestricted, not recommended).
MULTIWING_FILE_ROOTS=
MULTIWING_DOWNLOAD_DIR=

# Optional
MULTIWING_MCP_READ_ONLY=false
MULTIWING_TEAM_NAME=Faderlabs
MULTIWING_REQUEST_TIMEOUT_MS=60000
MULTIWING_ALLOW_INSECURE_HTTP=false
